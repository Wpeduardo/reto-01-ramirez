# Proveedor del modelo: anthropic (por defecto) u openai
LLM_PROVIDER=anthropic
# Modelo (opcional). Por defecto: claude-sonnet-5-5 (anthropic) o gpt-4.1-mini (openai)
LLM_MODEL=

# Clave del proveedor elegido. Solo vive en el backend: nunca en el front, el repositorio ni los logs.
ANTHROPIC_API_KEY=
# Solo si tu clave de Anthropic NO está asociada a un workspace (ID en platform.claude.com/settings/workspaces)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
# Solo para APIs compatibles con OpenAI distintas de la oficial.
#   Gemini (plan gratuito): https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama (local):         http://localhost:11434/v1
OPENAI_BASE_URL=

# Límites de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
MAX_TOKENS_RESPUESTA=2048
LLM_TIMEOUT_MS=60000
LIMITE_MENSAJES_POR_MINUTO=20

# Clave opcional para proteger el link público (se pide en el navegador)
ACCESS_KEY=

# Fecha (YYYY-MM-DD) para evaluar vigencias. Vacía = fecha de ejecución.
FECHA_REFERENCIA=

PORT=3000
